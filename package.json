{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun node_modules/astro/bin/astro.mjs dev",
    "build": "bun run content:ids:check && bun node_modules/astro/bin/astro.mjs build",
    "check": "bun node_modules/astro/bin/astro.mjs check",
    "content:ids:check": "bun scripts/content-ids.ts --check",
    "content:ids:write": "bun scripts/content-ids.ts --write",
    "preview": "bun node_modules/astro/bin/astro.mjs preview",
    "format": "bun node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "bun node_modules/prettier/bin/prettier.cjs --check .",
    "test": "bun test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/starlight": "^0.41.5",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@microflash/rehype-figure": "^2.1.4",
    "astro": "^7.1.6",
    "astro-remote": "^0.3.4",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "marked-plaintify": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-photo-view": "^1.2.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "0.35.3",
    "unist-util-is": "^6.0.1",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6",
    "vercel": "^58.4.4"
  }
}
